// RACECAR Neo - start and stop the lab dashboards without sudo.
//
// Installed to /etc/polkit-1/rules.d/ by scripts/setup_user_env.sh. The home
// page on port 8080 runs as the racecar user and switches which lab dashboard
// is active (one /drive publisher at a time). The grant covers those three
// units, that user, and start and stop; enabling, masking, and every other
// unit still ask for authentication.

polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return polkit.Result.NOT_HANDLED;
    }
    var units = ["racecar-webteleop.service", "racecar-linefollow.service",
                 "racecar-wallfollow.service"];
    var verbs = ["start", "stop"];
    if (units.indexOf(action.lookup("unit")) !== -1 &&
        verbs.indexOf(action.lookup("verb")) !== -1 &&
        subject.user === "racecar") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
