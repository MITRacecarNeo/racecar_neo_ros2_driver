[Unit]
Description=RACECAR Neo @NAME@ Dashboard (port @PORT@)
Wants=racecar-data.service
After=racecar-data.service
After=racecar-teleop.service

[Service]
Type=exec
User=racecar
Group=racecar
ExecStart=/home/racecar/ros2_ws/src/racecar_neo_ros2_driver/scripts/ros_exec.sh python3 @DIR@/@SCRIPT@
Restart=on-failure
RestartSec=5
Environment=HOME=/home/racecar
# RACECAR_DATA_DIR, from racecar-data.service.
EnvironmentFile=-/run/racecar/environment
WorkingDirectory=@DIR@

[Install]
WantedBy=multi-user.target
