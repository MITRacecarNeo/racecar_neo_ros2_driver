[Unit]
Description=RACECAR Neo Web Teleop Dashboard (port 8081)
After=racecar-teleop.service

[Service]
Type=exec
User=racecar
Group=racecar
ExecStart=/bin/bash -c '\
    source /opt/ros/jazzy/setup.bash && \
    source /home/racecar/ros2_ws/install/setup.bash && \
    exec python3 @DIR@/teleop.py'
Restart=on-failure
RestartSec=5
Environment=HOME=/home/racecar
WorkingDirectory=@DIR@

[Install]
WantedBy=multi-user.target
