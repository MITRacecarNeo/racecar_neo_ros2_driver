[Unit]
Description=RACECAR Neo Web Map Viewer (port 8084)
Wants=racecar-data.service
After=racecar-data.service
After=network.target

[Service]
Type=exec
User=racecar
Group=racecar
# Independent of teleop: the page offers "Start mapping" while autonomy is stopped.
ExecStart=/bin/bash -c '\
    source /opt/ros/jazzy/setup.bash && \
    source /home/racecar/ros2_ws/install/setup.bash && \
    exec python3 /home/racecar/ros2_ws/src/racecar_neo_ros2_driver/scripts/mapview.py'
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
Environment=HOME=/home/racecar
# RACECAR_DATA_DIR, from racecar-data.service.
EnvironmentFile=-/run/racecar/environment
Environment=ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
WorkingDirectory=/home/racecar/ros2_ws

[Install]
WantedBy=multi-user.target
