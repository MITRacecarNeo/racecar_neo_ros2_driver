[Unit]
Description=RACECAR Neo Teleop (control + sensors + ML + display)
After=network-online.target
Wants=network-online.target
# Wants= starts watchdog with teleop without requiring it; watchdog's
# BindsTo= stops it with teleop.
Wants=racecar-watchdog.service

[Service]
Type=exec
User=racecar
Group=racecar
ExecStart=/home/racecar/ros2_ws/src/racecar_neo_ros2_driver/scripts/launch_teleop.sh
Restart=on-failure
RestartSec=10
Environment=HOME=/home/racecar
WorkingDirectory=/home/racecar/ros2_ws
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
