[Unit]
# Diagnostic for eth0 address drops (changelog 0.7.4). Not installed by
# setup_services.sh; disable it once the question is settled.
#
# Enable for a soak:
#   sudo cp scripts/racecar-eth-monitor.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now racecar-eth-monitor
Description=RACECAR Neo eth0 addressing and link monitor (temporary diagnostic)
After=network.target NetworkManager.service

[Service]
Type=exec
User=racecar
Group=racecar
# No ROS environment needed; this reads sysfs, ip and nmcli only.
ExecStart=/usr/bin/python3 /home/racecar/ros2_ws/src/racecar_neo_ros2_driver/scripts/eth_monitor.py
Restart=always
RestartSec=10
Environment=HOME=/home/racecar
WorkingDirectory=/home/racecar
# The log is the deliverable, so keep it out of the journal's rotation.
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
